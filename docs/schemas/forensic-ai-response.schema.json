{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdft.invalid/schemas/forensic-ai-response.schema.json",
  "title": "KDFT grounded forensic AI response envelope",
  "description": "Validated application envelope. The model supplies claims and opaque context citation handles; KDFT resolves canonical provenance and constructs resolved_citations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "case_generation",
    "workflow",
    "status",
    "claims",
    "resolved_citations",
    "coverage",
    "limitations",
    "suggested_next_steps",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "case_generation": {
      "type": "integer",
      "minimum": 0
    },
    "workflow": {
      "enum": [
        "selected_artifacts",
        "artifact_query",
        "timeline",
        "artifact_explanation",
        "finding_draft"
      ]
    },
    "status": {
      "enum": [
        "answered",
        "partial",
        "insufficient_evidence",
        "rejected"
      ]
    },
    "headline": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "claims": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "resolved_citations": {
      "description": "Canonical provenance inserted by KDFT after citation-handle validation. The model must not author this object.",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/resolvedCitation"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "suggested_next_steps": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/nextStep"
      }
    },
    "generation": {
      "$ref": "#/$defs/generation"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "kind",
        "text",
        "citation_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "observed_fact",
            "derived_fact",
            "model_inference",
            "hypothesis",
            "limitation"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "method": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "model_confidence": {
          "description": "Allowed only for model inference or hypothesis. This is distinct from parser/classifier confidence.",
          "enum": ["low", "medium", "high", null]
        },
        "citation_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^cite-[A-Za-z0-9._-]+$",
            "maxLength": 128
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "observed_fact",
                  "derived_fact",
                  "model_inference",
                  "hypothesis"
                ]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "citation_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["model_inference", "hypothesis"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["model_confidence"],
            "properties": {
              "model_confidence": {
                "enum": ["low", "medium", "high"]
              }
            }
          },
          "else": {
            "properties": {
              "model_confidence": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived_fact"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["method"],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "resolvedCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "context_handle",
        "resolution_status",
        "artifact_id",
        "evidence_id",
        "artifact_kind",
        "parser",
        "sources"
      ],
      "properties": {
        "citation_id": {
          "type": "string",
          "pattern": "^cite-[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "context_handle": {
          "type": "string",
          "pattern": "^ctx-[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "resolution_status": {
          "const": "verified"
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_key": {
          "type": ["string", "null"],
          "maxLength": 2048
        },
        "display_name": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "artifact_time_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "parser": {
          "$ref": "#/$defs/parser"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/sourceCoordinate"
          }
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "name",
        "version",
        "schema_version",
        "status"
      ],
      "properties": {
        "execution_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "implementation_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "completed_with_diagnostics",
            "failed",
            "cancelled"
          ]
        }
      }
    },
    "sourceCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "coordinate_system"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_entry_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "source_path": {
          "type": ["string", "null"],
          "maxLength": 16384
        },
        "coordinate_system": {
          "enum": [
            "physical_media_bytes",
            "partition_logical_bytes",
            "decrypted_bitlocker_volume_logical_bytes",
            "filesystem_file_bytes",
            "filesystem_record",
            "registry_hive_bytes",
            "evtx_file_bytes",
            "sqlite_database_bytes",
            "sqlite_row"
          ]
        },
        "partition_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "volume_index": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "partition_start_offset_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "offset_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "length_bytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "record_identifier": {
          "type": ["string", "null"],
          "maxLength": 4096
        },
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "physical_offset_available": {
          "type": "boolean"
        },
        "coordinate_note": {
          "type": ["string", "null"],
          "maxLength": 4000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coordinate_system": {
                "const": "decrypted_bitlocker_volume_logical_bytes"
              }
            },
            "required": ["coordinate_system"]
          },
          "then": {
            "required": [
              "volume_index",
              "physical_offset_available",
              "coordinate_note"
            ],
            "properties": {
              "physical_offset_available": {
                "const": false
              },
              "coordinate_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_description",
        "query_complete",
        "eligible_artifacts",
        "retrieved_artifacts",
        "omitted_artifacts",
        "truncated",
        "truncation_reasons",
        "parser_jobs_total",
        "parser_jobs_incomplete",
        "case_generation_frozen"
      ],
      "properties": {
        "scope_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "query_complete": {
          "type": "boolean"
        },
        "eligible_artifacts": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "retrieved_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_artifacts": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "truncation_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "enum": [
              "row_limit",
              "byte_limit",
              "token_limit",
              "time_limit",
              "cancelled",
              "parser_incomplete",
              "unsupported_source",
              "diagnostic_omission"
            ]
          }
        },
        "sampling_method": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "parser_jobs_total": {
          "type": "integer",
          "minimum": 0
        },
        "parser_jobs_incomplete": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "case_generation_frozen": {
          "type": "boolean",
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "truncated": {
                "const": true
              }
            },
            "required": ["truncated"]
          },
          "then": {
            "properties": {
              "truncation_reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "nextStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "requires_examiner_action"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "requires_examiner_action": {
          "const": true
        },
        "proposed_scope": {
          "type": ["string", "null"],
          "maxLength": 4000
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local",
        "runtime_name",
        "runtime_version",
        "runtime_executable_sha256",
        "model_id",
        "model_sha256",
        "model_manifest_sha256",
        "prompt_template_sha256",
        "response_schema_version",
        "offline_enforced"
      ],
      "properties": {
        "local": {
          "const": true
        },
        "runtime_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime_executable_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "model_manifest_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "prompt_template_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "response_schema_version": {
          "const": "1.0.0"
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "temperature_millis": {
          "description": "Sampling temperature multiplied by 1000, recorded as an integer for exact audit serialization.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "offline_enforced": {
          "const": true
        }
      }
    }
  }
}
